# ==============================================================================
# Concrete Mix Designer (C++20 / Qt 6) — Git Attributes & Line Normalization
# ==============================================================================

# Default behavior: auto-detect text files and normalize line endings to LF in Git index
* text=auto

# C/C++ source code, headers, and templates (using built-in cpp diff driver)
*.cpp   text eol=lf diff=cpp
*.hpp   text eol=lf diff=cpp
*.h     text eol=lf diff=cpp
*.c     text eol=lf diff=cpp
*.cc    text eol=lf diff=cpp
*.cxx   text eol=lf diff=cpp
*.hxx   text eol=lf diff=cpp
*.inl   text eol=lf diff=cpp

# CMake build scripts, presets, and project configurations
CMakeLists.txt     text eol=lf
*.cmake            text eol=lf
*.cmake.in         text eol=lf
CMakePresets.json  text eol=lf
*.json             text eol=lf
*.yml              text eol=lf
*.yaml             text eol=lf

# Windows Resource scripts and templates
*.rc.in            text eol=lf
*.rc               text eol=crlf

# Qt Framework assets (UI XML, Resources XML, and Linguist translation files)
*.ui    text eol=lf
*.qrc   text eol=lf
*.ts    text eol=lf
*.qm    binary

# Documentation, Legal licenses, and embedded multilingual text assets
*.md    text eol=lf
LICENSE text eol=lf
NOTICE* text eol=lf
source/assets/**/*.txt text eol=lf
*.txt   text=auto

# Windows native scripts, PowerShell, and Inno Setup installer scripts (require CRLF)
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.iss   text eol=crlf

# Binary assets, icons, images, documents, compiled libraries, and databases
*.png      binary
*.ico      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.bmp      binary
*.svg      text eol=lf
*.pdf      binary
*.exe      binary
*.dll      binary
*.pdb      binary
*.lib      binary
*.a        binary
*.o        binary
*.obj      binary
*.zip      binary
*.7z       binary
*.tar      binary
*.gz       binary
*.db       binary
*.sqlite   binary
*.sqlite3  binary

# Git archive export ignore rules (exclude repository tools/CI from release archives)
.github/          export-ignore
.vscode/          export-ignore
repo/             export-ignore
mocks/            export-ignore
tests/            export-ignore
.gitattributes    export-ignore
.gitignore        export-ignore

# GitHub Linguist classification rules
docs/**                          linguist-documentation=true
MANUAL.md                        linguist-documentation=true
OBSERVACAO.md                    linguist-documentation=true
source/assets/**/*.txt           linguist-documentation=true
source/language/locale/*.qm      linguist-generated=true
repo/**                          linguist-vendored=true
mocks/**                         linguist-vendored=true
